# Sui RPC
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_SUI_GRAPHQL_URL=https://sui-testnet.mystenlabs.com/graphql

# Optional admin gate. Empty means any connected wallet is treated as admin for demos.
NEXT_PUBLIC_ADMIN_WALLETS=

# Seal IBE access package.
# Set this to the package ID returned by:
#   cd move/submission_registry && sui client publish
NEXT_PUBLIC_SUI_PACKAGE_ID=

# The PTB target evaluated by Seal key servers during decrypt.
# Format: <packageId>::submission_registry::seal_approve
NEXT_PUBLIC_SEAL_APPROVE_TARGET=

# Defaults to the verified decentralized Testnet key server if left empty.
# Format for each server:
#   objectId|weight|aggregatorUrl
NEXT_PUBLIC_SEAL_KEY_SERVERS=0xb012378c9f3799fb5b1a7083da74a4069e3c3f1c93de0b27212a5799ce1e1e98|1|https://seal-aggregator-testnet.mystenlabs.com
NEXT_PUBLIC_SEAL_THRESHOLD=1

# Optional Sui registry config for global submission discovery.
NEXT_PUBLIC_REGISTRY_ID=
